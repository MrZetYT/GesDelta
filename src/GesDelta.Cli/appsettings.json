{
    "ConnectionStrings": {
        "Default": "Host=localhost;Database=gesdelta;Username=postgres;Password=YOUR_PASSWORD"
    },
    "Logging": {
        "Dir": "%LOCALAPPDATA%/GesDelta/logs",
        "RetainDays": 30,
        "TraceLlm": true
    },
    "Sources": {
        "UserAgent": "GesDelta/1.0 (<контакт>)",
        "HostDelayMs": 1000,
        "HostDelaysMs": { "habr.com": 10000, "export.arxiv.org": 3000 },
        "RssFullTextMinChars": 1500,
        "MaxNewMaterialsPerRun": 10,
        "MaxItemsPerSource": 20
    },
    "Orchestration": {
        "Collector": { "PausesSec": [2, 5, 10], "HttpTimeoutSec": 30 },
        "Llm": {
            "CallTimeoutSec": 120,
            "NetworkRetries": 3, "NetworkPausesSec": [5, 15, 45],
            "RateLimitRetries": 3, "RateLimitPausesSec": [30, 60, 120],
            "Chain": [ { "Provider": "OpenRouter", "Model": "<основная>", "StructuredOutput": true }, { "Provider": "OpenRouter", "Model": "<вторая>", "StructuredOutput": false }, { "Provider": "Ollama", "Model": "<локальная>", "StructuredOutput": false, "NumCtx": 16384 } ],
            "MaxTokensPerRun": null
        },
        "Run": { "TimeoutMin": 60 },
        "Schedule": { "TickSec": 60, "RetryDelayMin": 60, "MaxConsecutiveUnclean": 3 }
    }
}